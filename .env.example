# Selects the LLM for every feature: legacy/shadow = local LLM, openrouter = OpenRouter
# (DeepSeek V4.1 Flash, plus Sales v2 for new sessions). Historical sales sessions keep their pipeline.
PIPELINE_MODE=legacy
# Inject only into the backend process. Never read another workspace's .env.
OPENROUTER_API_KEY=
SALES_MAX_TURNS=8
SALES_JEV_TIMEOUT_SECONDS=3
SALES_WRITER_TIMEOUT_SECONDS=4
SALES_LUNA_ARBITRATION_ENABLED=true
SALES_LUNA_TIMEOUT_SECONDS=6
# In openrouter mode, Part 1 (shoe recommendation) is graded by the OpenRouter rubric,
# falling back to the general LLM on failure.
SALES_PART1_TIMEOUT_SECONDS=30
# Restrict both Decisions and chat to providers that do not collect input data.
SALES_OPENROUTER_DATA_COLLECTION=deny
# Enable only when both requested routes have eligible ZDR endpoints.
SALES_OPENROUTER_ZDR=false
# Opt-in adaptive Lan dialogue (docs/sales-adaptive-dialogue.md). Frozen per new session.
SALES_ADAPTIVE_DIALOGUE_ENABLED=false
SALES_ADAPTIVE_REASONING=off
SALES_ADAPTIVE_MAX_TOKENS=4096
SALES_ADAPTIVE_REASONING_MAX_TOKENS=1024
SALES_ADAPTIVE_TIMEOUT_SECONDS=45

# Final evaluation uses deepseek/deepseek-v4.1-flash through OpenRouter in openrouter mode, otherwise the local LLM.
# It uses the OPENROUTER_API_KEY above; do not expose it to the browser.
FINAL_EVALUATION_REQUEST_TIMEOUT_SECONDS=180
FINAL_EVALUATION_MAX_PROMPT_CHARS=60000
FINAL_EVALUATION_MAX_TOKENS=12000

# Supertonic speech quality (inference steps, 1-20). Higher is cleaner but slower.
TTS_QUALITY=5
