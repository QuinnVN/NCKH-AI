# Sales v2 is opt-in for new sessions. Historical sessions keep their pipeline.
SALES_PIPELINE_MODE=legacy
# Inject only into the backend process. Never read another workspace's .env.
OPENROUTER_API_KEY=
SALES_MAX_TURNS=8
SALES_JEV_TIMEOUT_SECONDS=3
SALES_WRITER_TIMEOUT_SECONDS=4
SALES_LUNA_ARBITRATION_ENABLED=true
SALES_LUNA_TIMEOUT_SECONDS=6
# Part 1 (shoe recommendation) is graded by the OpenRouter rubric whenever
# OPENROUTER_API_KEY is set, falling back to the local model on failure.
SALES_PART1_TIMEOUT_SECONDS=30
# Restrict both Decisions and chat to providers that do not collect input data.
SALES_OPENROUTER_DATA_COLLECTION=deny
# Enable only when both requested routes have eligible ZDR endpoints.
SALES_OPENROUTER_ZDR=false

# Final evaluation uses deepseek/deepseek-v4.1-flash through OpenRouter, independent of local LLM settings.
# It uses the OPENROUTER_API_KEY above; do not expose it to the browser.
FINAL_EVALUATION_REQUEST_TIMEOUT_SECONDS=45
FINAL_EVALUATION_MAX_PROMPT_CHARS=16000
FINAL_EVALUATION_MAX_TOKENS=1024

# Supertonic speech quality (inference steps, 1-20). Higher is cleaner but slower.
TTS_QUALITY=5
